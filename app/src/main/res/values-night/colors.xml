<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 16 — Night/dark-mode colour overrides.
    Map-related UI components use these when the system is in dark mode.
    Material3 dynamic colour handles most theming automatically; these
    supplement areas where we use literal colour references.
-->
<resources>
    <!-- Offline / stale GPS banner background in dark mode -->
    <color name="offline_banner_background">#1F2937</color>

    <!-- Route polyline — slightly brighter in dark mode for visibility on dark map -->
    <color name="route_polyline_color">#60A5FA</color>

    <!-- ETA chip background in dark mode -->
    <color name="eta_chip_background">#1E3A5F</color>
    <color name="eta_chip_text">#93C5FD</color>
</resources>
