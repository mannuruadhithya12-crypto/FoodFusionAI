rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']));
      allow delete: if false; // Deletion handled by callable function deleteUserAccount
      
      // Addresses subcollection
      match /addresses/{addressId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt']));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Favorites subcollection
      match /favorites/{favoriteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'targetType', 'targetId', 'createdAt']));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Restaurants are publicly readable
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false; // Only admins can write
    }
    
    // Categories are publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Foods are publicly readable
    match /foods/{foodId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Orders can be read by the user who created them, and created by them.
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Prevent clients from directly modifying sensitive fields
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'orderStatus', 'paymentStatus', 'subtotal', 'totalAmount', 
          'deliveryFee', 'discount', 'userId', 'paymentReference', 
          'deliveryPartner', 'deliveryLocation', 'statusHistory', 
          'createdAt', 'estimatedDeliveryAt'
        ]));
    }
    
    // Carts are private to users
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Favorites (Legacy root level - block)
    match /favorites/{favoriteId} {
      allow read, write: if false;
    }
    
    // Reviews (Callable functions only for write)
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Reports (Callable functions only for write)
    match /reports/{reportId} {
      allow read, write: if false;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Offers
    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Analytics
    match /analytics/{analyticsId} {
      allow create: if true; // Depending on requirements, could limit to authenticated users
      allow read, write: if false;
    }
  }
}
